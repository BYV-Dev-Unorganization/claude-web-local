# Local binding. Keep loopback unless protected by VPN/authenticated reverse proxy.
APP_NAME=Claude Web Local
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_TIMEZONE=Asia/Makassar

# Provider settings. No provider credential or model ID is stored in the database.
AI_PROVIDER=
AI_PROTOCOL=anthropic-messages
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FABLE=
AI_MODEL_OPUS=
AI_MODEL_SONNET=
AI_MODEL_HAIKU=
AI_DEFAULT_MODEL=sonnet
AI_MAX_OUTPUT_TOKENS=8192
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_RETRIES=2

# Optional search / retrieval / voice adapters. Unconfigured capabilities remain unavailable.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

DATABASE_URL=file:./data/claude-web-local.sqlite
STORAGE_PATH=./data/storage
WORKSPACE_PATH=./data/workspaces
APP_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=20971520
WORKER_CONCURRENCY=2
TASK_MAX_ITERATIONS=30
TASK_MAX_RUNTIME_SECONDS=1800
TASK_MAX_TOOL_CALLS=100

# Optional allow-list for browser automation. Browser actions remain unavailable until an isolated worker is installed.
BROWSER_ALLOWED_HOSTS=

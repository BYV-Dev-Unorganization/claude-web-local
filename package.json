{
  "name": "claude-web-local",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @cwl/server",
    "dev:web": "npm run dev --workspace @cwl/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @cwl/server",
    "start": "npm run start --workspace @cwl/server",
    "build:sandbox": "docker build -t cwl-coding-sandbox:local -f workers/coding/Dockerfile workers/coding",
    "coding:status": "node -e \"fetch('http://127.0.0.1:3000/api/v1/runtime/status').then(r=>r.text()).then(console.log).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
